      "preboot": "",
      "emmcboot": "setenv bootargs $bootargs console=${console} mem=512M root=/dev/mmcblk3p${rootpart} ro rootfstype=ext4 rootwait quiet; mmc dev 0 0 && fatload mmc 0:${bootpart} ${loadaddr} /boot/${kernel} && fatload mmc 0:${bootpart} ${fdt_addr} /boot/${fdt} && bootz ${loadaddr} - ${fdt_addr}",
