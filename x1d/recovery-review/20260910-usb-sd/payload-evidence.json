    {
      "path": "usr/bin/program_farm.sh",
      "sha256": "2d3cf8bf120969961738d24af6c18aefeb3181d908146a78eb2d898b674ce4fb",
      "bytes": 2171,
      "selectedLines": [
        {
          "line": 6,
          "text": "RESTART_FARM_AFTER_PROG=0"
        },
        {
          "line": 30,
          "text": "# gpio_pca953x is auto loaded during boot, load if anyone unloaded it to be sure"
        },
        {
          "line": 34,
          "text": "echo \"Put FPGA PS in reset\""
        },
        {
          "line": 39,
          "text": "echo \"Reload kernel modules for NOR memory with FARM memory enabled\""
        },
        {
          "line": 40,
          "text": "modprobe -r m25p80 spi-nor"
        },
        {
          "line": 41,
          "text": "modprobe spi-nor probe_fpga_mem=Y"
        },
        {
          "line": 44,
          "text": "SIZE3=$(cat /proc/mtd | grep mtd3 | cut -d' ' -f 2)"
        },
        {
          "line": 45,
          "text": "SIZE4=$(cat /proc/mtd | grep mtd4 | cut -d' ' -f 2)"
        },
        {
          "line": 48,
          "text": "    echo \"Failed to probe QPSI memory mtd3. Will quit FPGA programming.\""
        },
        {
          "line": 53,
          "text": "    echo \"Failed to probe QPSI memory mtd4. Will quit FPGA programming.\""
        },
        {
          "line": 56,
          "text": "echo \"FPGA memory probed\""
        },
        {
          "line": 58,
          "text": "echo \"Programming even FPGA flash\""
        },
        {
          "line": 59,
          "text": "flashcp -v $1 /dev/mtd3"
        },
        {
          "line": 60,
          "text": "echo \"Programming odd FPGA flash\""
        },
        {
          "line": 61,
          "text": "flashcp -v $2 /dev/mtd4"
        },
        {
          "line": 64,
          "text": "modprobe -r m25p80 spi-nor"
        },
        {
          "line": 65,
          "text": "# Reload u-boot flash driver"
        },
        {
          "line": 66,
          "text": "modprobe spi-nor probe_fpga_mem=N"
        },
        {
          "line": 69,
          "text": "if [ $RESTART_FARM_AFTER_PROG -ne 0 ];then"
        },
        {
          "line": 78,
          "text": "    # Give FARM time to boot"
        }
      ]
    },
