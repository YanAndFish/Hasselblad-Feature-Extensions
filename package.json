{
  "name": "hasselblad-readonly-debug",
  "version": "0.1.0",
  "private": true,
  "description": "第一代 X2D 100C 只读调试客户端，默认离线",
  "main": "dist/app/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "build:native": "node tools/build-native.cjs",
    "start": "npm run build && npm run build:native && node tools/start.cjs",
    "test": "npm run build && node --test dist/CodeTests/*.test.js",
    "test:ui": "npm run build && node tools/ui-smoke.cjs",
    "test:package": "node tools/ui-smoke.cjs --packaged",
    "package:local": "npm run build && npm run build:native && node tools/package.cjs",
    "usb:metadata": "node tools/read-camera.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "44.3.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
